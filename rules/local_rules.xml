<!--
  Custom Wazuh tuning rules (manager: /var/ossec/etc/rules/local_rules.xml).
  Each rule is a child of a stock rule and DOWNGRADES one verified benign pattern to level 3.
  Events are kept and searchable; anything that doesn't match every condition keeps the
  parent's original severity. Write-ups: docs/tuning.md
-->
<group name="sysmon,local_tuning,">

  <!-- Finding 1: Spotify file dialog duplicating a handle to Explorer (0x40 = PROCESS_DUP_HANDLE, cannot inject) -->
  <rule id="100100" level="3">
    <if_sid>92910</if_sid>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)^C:\\\\Users\\\\[^\\\\]+\\\\AppData\\\\Roaming\\\\Spotify\\\\Spotify\.exe$</field>
    <field name="win.eventdata.grantedAccess">^0x40$</field>
    <description>Tuned: Spotify accessed Explorer with 0x40 (benign file-dialog handle), not injection</description>
    <mitre><id>T1055</id></mitre>
  </rule>

  <!-- Finding 3: PowerShell's AppLocker/execution-policy probe file, created and deleted on every launch -->
  <rule id="100101" level="3">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1\.0\\\\powershell\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)^C:\\\\Users\\\\[^\\\\]+\\\\AppData\\\\Local\\\\Temp\\\\__PSScriptPolicyTest_[a-z0-9]{8}\.[a-z0-9]{3}\.ps1$</field>
    <description>Tuned: PowerShell execution-policy test file (__PSScriptPolicyTest), benign</description>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- Finding 4: Tailscale re-creating its own inbound firewall rule at service start -->
  <rule id="100102" level="3">
    <if_sid>92043</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)^C:\\\\Program Files\\\\Tailscale\\\\tailscaled\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)name=Tailscale-In\b</field>
    <description>Tuned: Tailscale service re-creating its Tailscale-In firewall rule, benign</description>
    <mitre><id>T1562.004</id></mitre>
  </rule>

</group>
